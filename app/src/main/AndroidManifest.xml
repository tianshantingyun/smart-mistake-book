<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Camera is optional; the UI falls back gracefully when unavailable -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SmartMistakeBookApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartMistakeBook"
        android:usesCleartextTraffic="false">

        <!-- A7（4C）：singleTop——单 Activity 应用里分享/通知都落回同一个实例（onNewIntent），
             既避免叠出第二个 MainActivity，也不会与 ActivityScenario 的 singleTask 限制冲突。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A7（4C）：系统分享 → 录入入口。单文件与多文件各一条过滤；类型门在代码侧
                 再收一遍（scheme/类型/数量/大小），这里只声明"愿意接收图片与 PDF"。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ReviewReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- An app update cancels every AlarmManager alarm; without this
                     the daily reminder would stay silent until the student next
                     opens the app (audit 2026-09-09). -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
