<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only Markdown/math renderer harness. -->
        <activity
            android:name=".FormatTestActivity"
            android:exported="false"
            android:label="格式测试" />
        <!-- KF-29 绑定复核屏：只随 debug 变体安装，供 QA 用 adb am start 驱动。
             导出是 adb 驱动所必需（非导出组件会被 SecurityException: not exported from uid
             拒绝），边界靠本清单所属的 debug 源集，而不是 exported 标志——与
             TestSeedModelConfigReceiver 同一条理由；release 不合并本清单，不进学生面。 -->
        <activity
            android:name=".BindingAuditActivity"
            android:exported="true"
            android:label="绑定复核" />
        <!-- KD-48 知识测验证据审计屏：只读消费 KnowledgeQuizEvidenceAudit.scanRows()，
             同样只随 debug 变体安装，供 QA 用 adb am start 驱动。导出是 adb 驱动所必需，
             边界靠本清单所属的 debug 源集，而不是 exported 标志。 -->
        <activity
            android:name=".KnowledgeEvidenceAuditActivity"
            android:exported="true"
            android:label="知识测验证据审计" />
        <!-- 模型配置注入桩：只随 <flavor>Debug 变体安装，供 QA 用 adb 播种模型配置
             （示例见 TestSeedModelConfigReceiver 的 KDoc）。导出是 adb 驱动所必需，
             边界靠本清单所属的 debug 源集，而不是 exported 标志。 -->
        <receiver
            android:name=".TestSeedModelConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tingyun.smartmistakebook.TEST_SEED_MODEL_CONFIG" />
            </intent-filter>
        </receiver>
        <!-- 失败模型调用响应原文的采集开关（KD-38/AUD-24 证据通道）：只随 debug 变体安装，
             默认关，QA 用 adb 广播开/关（示例见 TestCaptureModelFailuresReceiver 的 KDoc）。
             导出是 adb 驱动所必需，边界同样靠本清单所属的 debug 源集。 -->
        <receiver
            android:name=".TestCaptureModelFailuresReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tingyun.smartmistakebook.TEST_CAPTURE_MODEL_FAILURES" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
