{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smart-mistake-book.local/acceptance/ledger.schema.json",
  "title": "批次 44 验收台账行",
  "description": "docs/acceptance/ledger.md 的单行数据模型；证据 token 语法与 report/lint 共用。",
  "type": "object",
  "required": ["id", "domain", "check", "method", "evidence", "verdict"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(D0|[A-J]|FIX|GATE)-[0-9]{3}$",
      "description": "域前缀 + 三位序号；全表 1200 个唯一 id。"
    },
    "domain": {
      "type": "string",
      "enum": ["D0", "A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "FIX", "GATE"]
    },
    "check": {
      "type": "string",
      "minLength": 1,
      "description": "可判定的检查陈述；不得含竖线。"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "description": "落点：命令/测试路径/设备命令/review 文件。`<...>` 是显式缺口。"
    },
    "evidence": {
      "type": "string",
      "description": "`-` 或 `;` 分隔的证据 token 列表；token 语法见 evidenceToken。"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED"]
    }
  },
  "definitions": {
    "evidenceToken": {
      "type": "string",
      "pattern": "^(cmd|test|device|review|file|hash):[^;|]+(#[A-Za-z_][A-Za-z0-9_]*=[^,;]*)?$",
      "description": "kind:repo/relative/path#k=v[,k2=v2]。kind=cmd/test/device/review 计为独立证据类；file/hash 仅辅助。"
    }
  }
}
