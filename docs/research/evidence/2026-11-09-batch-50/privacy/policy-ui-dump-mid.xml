artmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,66][1036,139]" /><node index="1" text="14–17 岁用户同样建议在监护人指导下使用；应用不含社交、私信、评论、广告与内购。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,156][1036,282]" /><node index="2" text="本应用不建立账号体系，不收集与学习无关的身份信息。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,299][1036,425]" /><node index="3" text="AI 生成内容与标识" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,475][405,539]" /><node index="4" text="讲题解析与配图由人工智能生成，相关内容旁显示「AI 生成」角标；导出的 PDF/Word 含「本文件含 AI 生成内容」的可见说明，并在文件属性中写入隐式标识。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,556][1036,748]" /><node index="5" text="AI 生成内容可能存在错误或偏差，请以教材、课堂讲授和老师批改为准。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,765][1036,891]" /><node index="6" text="所用模型服务的名称与备案信息见《AI 生成内容说明》；本应用自身的备案信息见下一章。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,908][1036,1034]" /><node index="7" text="备案与运营主体信息" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1084][440,1148]" /><node index="8" text="运营主体：尚未取得（备案主体信息取得后在本页公示）。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1165][1036,1291]" /><node index="9" text="App 备案号：尚未取得（完成 App 备案后在本页与商店详情页公示）。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1308][1036,1434]" /><node index="10" text="联系方式：尚未取得（备案完成后公示可用的联系渠道）。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bound