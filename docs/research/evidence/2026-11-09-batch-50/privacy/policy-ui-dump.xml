lse" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[61,105][193,237]" /></node><node index="1" text="隐私政策" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[204,131][1019,211]" /><node index="2" text="" resource-id="" class="android.view.View" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,331][1036,2340]"><node index="0" text="" resource-id="privacy_policy_screen" class="android.view.View" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,378][1036,2340]"><node index="0" text="隐私政策（版本 2026-11-08，生效日期 2026-11-08）" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,378][1009,438]" /><node index="1" text="我们保存哪些数据" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,488][396,552]" /><node index="2" text="本应用是本地优先的学习工具：下面这些数据默认只保存在这台设备的应用私有目录里，不上传服务器。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,569][1036,695]" /><node index="3" text="错题本：题目与题面修订、练习单元、草稿、标签与知识点关系、题目侧的治理记录。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,712][1036,838]" /><node index="4" text="掌握库：学习证据、掌握度投影、复习计划与队列、复习会话与教学建议。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,855][1036,981]" /><node index="5" text="讲题会话：你与讲题功能的对话消息，以及消息引用的题图。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,998][1036,1124]" /><node index="6" text="题图：你拍摄或导入的原始图片保存在应用私有的图片目录，供题目与讲题使用。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1141][1036,1267]" /><node index="7" text="设置：模型服务地址、模型名称等本机设置；API Key 由系统安全存储保护，应用不会把它写进数据库、日志或备份。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1284][1036,1476]" /><node index="8" text="临时内容：未完成的临时照片按过期规则清理，不会自动进入错题本。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1493][1036,1619]" /><node index="9" text="什么情况下内容会离开本机" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1669][572,1733]" /><node index="10" text="只有你在讲题、拍照识别或整理等操作中主动发起请求时，当前内容才会发送给你选择的模型服务（BYOK：由你自行配置服务地址、模型与密钥）。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1750][1036,1942]" /><node index="11" text="一次请求会发送：当前题目与本次消息、你为本次请求明确授予的题图、所选服务商与模型标识，以及一段受限的教学上下文。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1959][1036,2151]" /><node index="12" text="发送受本机预算与次数上限约束；应用进程被重建后不会自动续发，必须由你再次发起。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,2168][1036,2294]" /><node index="13" text="你随时可以在模型设置里清空配置；清空后应用不再向任何服务发起请求。" resource-id="" class="android.widget.TextView" package="com.tingyun.smartmistakebook.localfirst" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,2311][1036,2340]" /></node></node></node></node></node></node></node></node></node></node></node></hierarchy>